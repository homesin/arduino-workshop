/*
 * 第三章 · 序列埠：讓板子「說話」
 *
 * 目標：第一次在電腦上看到板子送來的文字與數字。
 * 接線：不用接任何東西。
 *
 * 上傳後：工具 → 序列埠監控視窗，右下角的速率選 9600。
 * 看到亂碼，幾乎都是速率沒選 9600。
 */

int count = 0;                    // 變數：用來記「已經說了幾次」

void setup() {
  Serial.begin(9600);             // 開啟序列埠，速率 9600；監控視窗要選一樣的
  Serial.println("你好，我是 Arduino");
}

void loop() {
  count = count + 1;              // 每圈加 1
  Serial.print("第 ");
  Serial.print(count);            // print 不換行，println 才會換行
  Serial.println(" 次");

  if (count >= 10) {              // 條件判斷：數到 10 就多說一句
    Serial.println("已經數到 10 了");
    count = 0;                    // 歸零，重新開始
  }

  delay(1000);                    // 每秒說一次
}

/*
 * 動手改改看
 *   1. 把 delay 改成 200，數字會跳多快？
 *   2. 把 10 改成 5，多說的那句話會多久出現一次？
 *   3. 把 Serial.begin 的 9600 改成 115200 再上傳，
 *      監控視窗的速率不跟著改，會看到什麼？（亂碼 = 兩邊速率不一致）
 *
 * 之後所有感測器的數字，都是用這個方法送到電腦上看的。
 * 上傳新程式之前，先關掉序列埠監控視窗，不然會搶同一個連接埠。
 */
