# 複製這個檔案成 .env，再照下面填。.env 是你自己的設定，不要傳給別人、不要貼到群組。
#
# ── 三個值，每個人都要填「自己的」──────────────────────────
# ThingSpeak 與 ntfy 都是自己建立自己的：不要用別人（包含講師）的頻道或主題。

# 1) Arduino 接在哪個連接埠。Windows 是 COM3 / COM4…
#    不確定的話跑 `npm run ports` 會列出來
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# 2) 你自己的 ThingSpeak 頻道的 Write API Key
#    ThingSpeak 頻道頁面 → API Keys → Write API Key（不是 Read）
#    留空 = 不上傳雲端（其他功能照常運作）
THINGSPEAK_WRITE_KEY=

# 3) 你自己取的 ntfy 主題名稱（要和手機或網頁訂閱的一模一樣）
#    ntfy 不用註冊。主題名稱等同密碼：任何人知道就能訂閱、也能發訊息進來，
#    所以一定要加一串隨機英數字，不要取 test 或 arduino 這種猜得到的名字。
#    例如 arduino-k7m2q9x4 只是範例，請自己重新取一個，不要照抄。
#    留空 = 不真的送出（只在終端機印出「原本要送出的內容」）
NTFY_TOPIC=

# 本課程的通知只用 ntfy
NOTIFY_CHANNELS=ntfy

# ── 下面都有預設值，通常不用改 ────────────────────────────
# 儀表板網址 http://localhost:3000
PORT=3000

# ThingSpeak 免費版最短 15 秒一筆，不要調更小（程式會自動再多留 2 秒餘裕，實際約每 17 秒一筆）
THINGSPEAK_INTERVAL_SEC=15

# HC-SR04 量到的距離小於這個公分數就算「有東西靠近」
# 現場先看儀表板上的實際距離再調
NEAR_CM=30

# 光敏讀值大於這個數字算「光線被遮住」（0 最亮、1023 最暗）
# 現場先看儀表板上的光線數字：平常多少、用手遮住變多少，門檻放中間
LIGHT_DARK_ABOVE=400

# 濕度比「最近 30 秒平均」高出幾個百分點，算「濕度突然升高」（對 DHT11 呼氣）
HUMIDITY_RISE_PCT=8

# 同一種警報幾秒內不重複發，避免洗版
ALERT_COOLDOWN_SEC=60

# 每天最多發幾則 ntfy，防止一天發太多
NTFY_DAILY_LIMIT=200
NTFY_SERVER=https://ntfy.sh

# 程式也支援 LINE、Discord、Slack、Telegram、Email，本課程不用，所以不列在這裡。
# 要用的話，變數名稱見 README.md。
