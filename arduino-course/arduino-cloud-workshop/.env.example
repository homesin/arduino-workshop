# ── 這三個值是學員上課要自己填的 ─────────────────────────
# 1) Arduino 接在哪個連接埠。Windows 是 COM3 / COM4…
#    不確定的話跑 `npm run ports` 會列出來
SERIAL_PORT=COM3
SERIAL_BAUD=9600

# 2) ThingSpeak 頻道的 Write API Key
#    ThingSpeak 頻道頁面 → API Keys → Write API Key
#    留空 = 不上傳雲端（其他功能照常運作）
THINGSPEAK_WRITE_KEY=

# 3) LINE 官方帳號的 Channel Access Token
#    LINE Developers → Messaging API → Channel access token (long-lived)
#    留空 = 不發 LINE（會在終端機印出「原本要送出的內容」）
LINE_CHANNEL_ACCESS_TOKEN=

# ── 下面都有預設值，通常不用改 ───────────────────────────
# 儀表板網址 http://localhost:3000
PORT=3000

# ThingSpeak 免費版最短 15 秒一筆，不要調更小
THINGSPEAK_INTERVAL_SEC=15

# 火焰感測 A0 讀值低於這個數字就算偵測到火
# 現場一定要先看終端機的實際數值再調
FLAME_THRESHOLD=400

# 同一種警報幾秒內不重複發，避免洗版
ALERT_COOLDOWN_SEC=60

# 每天最多發幾則 LINE。免費方案一個月只有 200 則，務必保留這個上限
LINE_DAILY_LIMIT=20

# ── 其他通知去處（填了就啟用，可同時開好幾家）──────────────
# 只想測其中一家時填這個（逗號分隔），留空 = 有填憑證的全部啟用
NOTIFY_CHANNELS=

# ntfy.sh：不用註冊。手機裝 ntfy App 訂閱同一個主題就會收到通知。
# 主題名稱等同密碼（任何人知道就能訂閱、也能發訊息進來），一定要加隨機字串，
# 不要取 test 或 arduino 這種猜得到的名字。
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_DAILY_LIMIT=200

# Discord：頻道設定 → 整合 → 建立 Webhook → 複製網址
DISCORD_WEBHOOK_URL=

# Slack：App 設定 → Incoming Webhooks → Add New Webhook to Workspace
SLACK_WEBHOOK_URL=

# Telegram：跟 @BotFather 拿 token；chat id 用 getUpdates 查
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email：人人都有信箱，不用裝 App，但推播不即時、容易被丟垃圾郵件。
# Gmail 一定要用「應用程式密碼」，不是你的登入密碼 ——
# Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼（16 碼）。
# 沒開兩步驟驗證的話，那個選項不會出現。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
EMAIL_DAILY_LIMIT=50
